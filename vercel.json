{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/movies(.*)",
      "destination": "https://avalanche-task.onrender.com/movies$1"
    },
    {
      "source": "/theatres(.*)",
      "destination": "https://avalanche-task.onrender.com/theatres$1"
    },
    {
      "source": "/screens(.*)",
      "destination": "https://avalanche-task.onrender.com/screens$1"
    },
    {
      "source": "/seats(.*)",
      "destination": "https://avalanche-task.onrender.com/seats$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://avalanche-task.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
